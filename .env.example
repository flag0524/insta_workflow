# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 마세요.

# Instagram Graph API
# IG_USER_ID: 인스타 프로페셔널 계정의 IG User ID (페이스북 페이지에 연결된 상태여야 함)
# IG_ACCESS_TOKEN: 장기 액세스 토큰 (60일 만료 — 만료 전 갱신 필요)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Cloudinary — 영상/커버를 공개 URL로 올리는 용도
# Graph API가 로컬 파일을 받지 않아 반드시 필요합니다
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 텔레그램 실패 알림 (선택 — 비워두면 알림 없이 동작)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
